{
  "name": "CriminalRecord",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "missed_court_date",
        "contract_breach",
        "warrant_issued",
        "original_charge"
      ],
      "description": "How this record was added"
    },
    "charge": {
      "type": "string",
      "description": "The criminal charge text"
    },
    "contract_id": {
      "type": "string",
      "description": "Related contract if any"
    },
    "warrant_id": {
      "type": "string",
      "description": "Related warrant if any"
    },
    "severity": {
      "type": "string",
      "enum": [
        "misdemeanor",
        "felony",
        "federal"
      ],
      "default": "misdemeanor"
    },
    "section": {
      "type": "string",
      "description": "Criminal Code section (e.g. s. 145(1)(a))"
    },
    "code_reference": {
      "type": "string",
      "description": "Full legal citation (Criminal Code, R.S.C. 1985, c. C-46, ...)"
    },
    "offence_type": {
      "type": "string",
      "enum": [
        "summary",
        "indictable",
        "hybrid"
      ],
      "description": "Canadian offence classification"
    },
    "max_penalty": {
      "type": "string",
      "description": "Maximum penalty for the offence"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Recording court jurisdiction (e.g. Alberta Court of Justice)"
    },
    "record_number": {
      "type": "string",
      "description": "Official Alberta criminal record number"
    },
    "added_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "charge",
    "source",
    "added_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}